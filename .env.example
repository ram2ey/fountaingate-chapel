# Runtime settings only. Builds and current unavailable pages need no credentials.
# Never prefix database credentials or private provider keys with NEXT_PUBLIC_.
# Use separate database/users for development, staging and production.
DATABASE_URL=postgresql://fgc_app:replace-me@postgres:5432/fountaingate
# Supply only to controlled migration commands, not the production web container.
MIGRATION_DATABASE_URL=postgresql://fgc_owner:replace-me@postgres:5432/fountaingate
# require verifies TLS certificates. disable is only for a trusted private Docker network.
# Do not add sslmode/sslcert/etc. query parameters to connection URLs.
DATABASE_SSL_MODE=require
# Optional base64-encoded PEM CA for a private CA; verification remains enabled.
# DATABASE_CA_BASE64=
DATABASE_POOL_MAX=5
DATABASE_CONNECT_TIMEOUT_MS=5000

# Runtime origin and private file storage.
APP_ORIGIN=https://church.example.com
UPLOAD_DIRECTORY=/app/uploads
# Broadcast-worker settings will be added in later phases.
PAYMENTS_ENABLED=false
# Set true only after confirming the hosted API contract with Hubtel and passing
# the merchant-account staging checks in docs/PHASE-5-SETUP.md.
HUBTEL_CONTRACT_CONFIRMED=false
# Server-only Hubtel credentials; configure in Coolify runtime variables.
# HUBTEL_CLIENT_ID=
# HUBTEL_CLIENT_SECRET=
# HUBTEL_MERCHANT_ACCOUNT=
# Random 32-byte base64url callback capability. Never log callback paths/query strings.
# HUBTEL_CALLBACK_TOKEN=

# Identity process role: fgc_auth; never use the migration owner here.
AUTH_DATABASE_URL=postgresql://fgc_auth:replace-me@postgres:5432/fountaingate
# Generate a random 32-byte base64 key; keep stable and back it up securely.
# AUTH_ENCRYPTION_KEY=
# mNotify API v2 and an approved sender ID (maximum 11 characters). Runtime only.
# MNOTIFY_API_KEY=
# MNOTIFY_SENDER_ID=
